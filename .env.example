# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The anon key is the only key that may reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS — never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by scripts/db.mjs to apply migrations.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Cloudflare R2  (server-side only — presigned URLs are minted on the server)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Two buckets. ORIGINALS is the evidence of record — the untouched upload, EXIF
# intact, never overwritten. DISPLAY holds regenerable derivatives (HEIC
# transcoded, resized) and can be emptied without losing anything.
R2_BUCKET_ORIGINALS=plate-chase-originals
R2_BUCKET_DISPLAY=plate-chase-display
